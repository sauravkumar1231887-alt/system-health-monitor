DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,192.168.8.63
PORT=8000
SECURE_HSTS_SECONDS=0

# Point at the existing MongoDB database and collections.
MONGODB_URI=mongodb://127.0.0.1:27017/system-health-monitor
MONGODB_DATABASE=system-health-monitor
MONGO_URI=

# Set DEMO_MODE=true only for local fixture-based development.
DEMO_MODE=false
JWT_SECRET_KEY=replace-with-a-long-jwt-signing-secret
JWT_ACCESS_TOKEN_LIFETIME=28800

FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://192.168.8.63:5173
RATE_LIMIT_PER_MINUTE=180
ORGANIZATION_NAME=System Monitoring Health
API_BASE_URL=http://localhost:8000/api